seed_cost = 1
plant_cost = {"water": 5.0}
grow_time = 30.0
water_use = 0.08
light_use = 0.06
essence = 0.6
oxygen = 0.25
habitat = 0.6
seed_rate = 0.016
biodiversity = 1.0
bloom_time = 40.0
color = Color(0.25, 0.82, 0.42, 1)
accent = Color(0.75, 1.0, 0.85, 1)

[sub_resource type="Resource" id="Resource_lily"]
script = ExtResource("2_def")
