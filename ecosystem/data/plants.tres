[ext_resource type="Script" path="res://scripts/data/plant_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_fern"]
script = ExtResource("2_def")
id = &"fern"
display_name = "Helecho Burbuja"
description = "Un helecho resistente que respira burbujas de oxígeno. La primera vida del ecosistema."
