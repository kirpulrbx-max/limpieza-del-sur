[gd_resource type="Resource" script_class="DefList" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/def_list.gd" id="1_list"]
[ext_resource type="Script" path="res://scripts/data/fauna_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_butterfly"]
script = ExtResource("2_def")
id = &"butterfly"
display_name = "Mariposas de vidrio"
description = "Polinizan la flora (+esencia) y producen polen."
model = &"butterfly"
habitat_kind = &"air"
oxygen_use = 0.06
repro_rate = 0.06
essence = 0.15
produce = {"pollen": 0.02}
biodiversity = 3.0
plant_bonus = 0.01
intro_cost = {"essence": 100.0, "oxygen": 30.0}
intro_amount = 2.0
unlock_tech = &"fauna"
color = Color(0.55, 0.85, 1.0, 1)

[sub_resource type="Resource" id="Resource_fish"]
script = ExtResource("2_def")
id = &"fish"
display_name = "Peces burbuja"
description = "Viven en los estanques. Filtran el agua y crean perlas de rocío."
