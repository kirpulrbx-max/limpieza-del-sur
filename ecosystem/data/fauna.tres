[sub_resource type="Resource" id="Resource_jelly"]
script = ExtResource("2_def")
id = &"jelly"
display_name = "Medusas aéreas"
description = "Flotan entre las islas absorbiendo luz. Generan muchísima esencia."
model = &"jelly"
